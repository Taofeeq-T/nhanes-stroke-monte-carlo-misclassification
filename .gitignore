# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# R session files
.Rhistory
.RData
.Rproj.user/

# Notebook checkpoints
.ipynb_checkpoints/

# macOS
.DS_Store
**/.DS_Store

# Environment and secrets
.env

# Local working folders
artifacts_old/
supplementary_figs/
main_figs/

